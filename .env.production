# ─────────────────────────────────────────────────────────────────────────────
# SIPADU CBT — Production Environment Variables
#
# File ini digunakan untuk deployment production (Vercel atau serve lokal).
# JANGAN commit file ini ke git jika GAS_URL sudah diisi dengan URL asli.
# ─────────────────────────────────────────────────────────────────────────────

# URL GAS Web App (WAJIB — isi dengan URL deployment Apps Script Anda)
# Dapatkan dari: Apps Script → Deploy → New Deployment → Web App → URL
# Format: https://script.google.com/macros/s/<ID>/exec
GAS_URL=https://script.google.com/macros/s/AKfycbwHNjzGCBgrM3umOSYJzY1WO079ucscGUUbVUWphai44wOnIhTbu1hgXrh_7ummaVyb/exec

# App Name (opsional — override nilai dari GAS config)
# APP_NAME=SIPADU CBT
